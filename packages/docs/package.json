{
  "name": "@mint/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @futurewiz-rms/mint && node scripts/sync-changelog.mjs && node scripts/check-sidebar-order.mjs",
    "prebuild": "npm run build -w @futurewiz-rms/mint && node scripts/sync-changelog.mjs && node scripts/check-sidebar-order.mjs",
    "dev": "next dev --webpack --port 3000",
    "build": "next build --webpack",
    "sidebar:check": "node scripts/check-sidebar-order.mjs",
    "postbuild": "node scripts/build-search.mjs",
    "start": "next start --port 3000",
    "preview": "npm run build && next start --port 3000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@futurewiz-rms/mint": "*",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.187.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.187.0",
    "pagefind": "^1.3.0"
  }
}
